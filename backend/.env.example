# Postgres/PostGIS mit dem redaktionellen Schema (schema.sql)
DATABASE_URL=postgresql://USER:PASSWORT@HOST:5432/DATENBANK

# Port der Express-API
PORT=3000

# Martin (Vector-Tile-Server)
# Default ohne Angabe: http://martin:3000 (Service-Name im Cluster)
MARTIN_URL=

# Wert des Access-Control-Allow-Origin-Headers. Default ohne Angabe: *
CORS_ORIGIN=*
