{
  "name": "klima-app-backend",
  "version": "1.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "description": "Express-API und Martin-Tile-Proxy der Klima-App Soest (UCT)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "nodemon --watch src --exec \"node --env-file=.env src/server.js\"",
    "db:schema": "node --env-file=.env src/scripts/apply-sql.js db/schema.sql",
    "db:seed": "node --env-file=.env src/scripts/apply-sql.js db/seed.sql",
    "db:directus": "node --env-file=.env src/scripts/apply-sql.js db/directus_setup.sql"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
