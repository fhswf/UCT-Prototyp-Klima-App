# Kopie als .env.local anlegen. Alle Werte haben sinnvolle Defaults —
# im Normalfall wird hier nichts gebraucht.
#
# ACHTUNG: VITE_*-Variablen werden beim Build fest ins Bundle geschrieben.
# Ein Image, das mit anderen Werten laufen soll, muss neu gebaut werden.

# Basis-URL der API. Default: /api/v1 (same-origin, im Dev über den Vite-Proxy,
# in Produktion über den Ingress). Nur setzen, wenn die API woanders liegt.
VITE_API_BASE_URL=

# Basiskarten-Style. Default: basemap.de farbig (amtlich, dl-de/by-2-0).
# Alternativen: .../styles/bm_web_gry.json (grau), .../styles/bm_web_top.json
VITE_BASEMAP_STYLE=
