{
  "name": "klima-app-frontend",
  "version": "1.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "description": "Vue-3-Frontend der Klima-App Soest (UCT)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-local": "vite --host",
    "dev:all": "run-p dev-local backend",
    "backend": "npm --prefix ../backend run dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "dompurify": "^3.4.15",
    "maplibre-gl": "^5.24.0",
    "markdown-it": "^15.0.1",
    "material-symbols": "^0.46.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.78.0",
    "eslint-plugin-vue": "~10.10.0",
    "globals": "^17.11.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.78.0",
    "prettier": "3.9.6",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-svg-loader": "^5.1.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
